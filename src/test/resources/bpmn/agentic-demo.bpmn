      <bpmndi:BPMNShape id="Activity_08i65v7_di" bpmnElement="Activity_1o2n3ok" isExpanded="true">
        <dc:Bounds x="320" y="640" width="350" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0m4e316_di" bpmnElement="Event_1dmxcvf">
        <dc:Bounds x="360" y="722" width="36" height="36" />
      </bpmndi:BPMNShape>
