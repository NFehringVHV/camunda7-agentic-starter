<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AgenticDemo" targetNamespace="http://camunda7agentic.github.io/agentic" exporter="Camunda Modeler" exporterVersion="5.43.1">
  <bpmn:message id="Msg_getWeather" name="getWeather" />
  <bpmn:message id="Msg_sendEmail" name="sendEmail" />
  <bpmn:message id="Message_155vi7e" name="LLM-Result" />
  <bpmn:collaboration id="Collaboration_0f1g2ms">
    <bpmn:participant id="Participant_0kc4zex" name="agentic-demo" processRef="agentic-demo" />
  </bpmn:collaboration>
  <bpmn:process id="agentic-demo" name="Agentic Demo" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="StartEvent_Start" name="Start">
      <bpmn:outgoing>Flow_Start_to_Llm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_LlmAgentic" name="LLM Agentic" camunda:type="external" camunda:topic="llm-agentic">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="systemPromptUseCase">You are a helpful assistant. Answer concisely.</camunda:inputParameter>
          <camunda:inputParameter name="toolCallVariableName">toolCall</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_Llm</bpmn:incoming>
      <bpmn:incoming>Flow_ToolResult_to_Llm</bpmn:incoming>
      <bpmn:outgoing>Flow_Llm_to_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Done" name="agenticDone?" default="Flow_Gw_to_CallTool">
      <bpmn:incoming>Flow_Llm_to_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_to_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_to_CallTool</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Done" name="Done">
      <bpmn:incoming>Flow_Gw_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_to_Llm" sourceRef="StartEvent_Start" targetRef="Task_LlmAgentic" />
    <bpmn:sequenceFlow id="Flow_ToolResult_to_Llm" sourceRef="Receive_ToolResult" targetRef="Task_LlmAgentic" />
    <bpmn:sequenceFlow id="Flow_Llm_to_Gateway" sourceRef="Task_LlmAgentic" targetRef="Gateway_Done" />
    <bpmn:sequenceFlow id="Flow_Gw_to_End" sourceRef="Gateway_Done" targetRef="EndEvent_Done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${agenticDone == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gw_to_CallTool" sourceRef="Gateway_Done" targetRef="Activity_0583vz5" />
    <bpmn:sequenceFlow id="Flow_1f8mf1y" sourceRef="Activity_0583vz5" targetRef="Receive_ToolResult" />
    <bpmn:intermediateCatchEvent id="Receive_ToolResult" name="Tool result" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_1f8mf1y</bpmn:incoming>
      <bpmn:outgoing>Flow_ToolResult_to_Llm</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Receive" messageRef="Message_155vi7e" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_0583vz5" name="Call tool" camunda:asyncBefore="true" camunda:type="external" camunda:topic="agentic-tool-correlation">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="toolCallVariableName">toolCall</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_to_CallTool</bpmn:incoming>
      <bpmn:outgoing>Flow_1f8mf1y</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Activity_1o2n3ok" name="Tool: sendEmail" triggeredByEvent="true">
      <bpmn:documentation>Sends an email to a recipient with a subject and a body.</bpmn:documentation>
      <bpmn:startEvent id="Event_1dmxcvf" isInterrupting="false" camunda:asyncBefore="true">
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="to" value="fromAi(&#34;toolCall.to&#34;, &#34;recipient email address&#34;)" />
            <camunda:property name="subject" value="fromAi(&#34;toolCall.subject&#34;, &#34;email subject&#34;)" />
            <camunda:property name="body" value="fromAi(&#34;toolCall.body&#34;, &#34;email body text&#34;)" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_1dlwpiw</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_08evzzs" messageRef="Msg_sendEmail" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1dlwpiw" sourceRef="Event_1dmxcvf" targetRef="Activity_0q8uboi" />
      <bpmn:sequenceFlow id="Flow_0y3gf7n" sourceRef="Activity_0q8uboi" targetRef="Event_05r8gxf" />
      <bpmn:endEvent id="Event_05r8gxf" name="LLM-Result">
        <bpmn:incoming>Flow_0y3gf7n</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1xcfotg" camunda:expression="${execution.processEngineServices.runtimeService.createMessageCorrelation(&#39;LLM-Result&#39;).processInstanceId(execution.processInstanceId).setVariable(&#39;toolCallResult&#39;, toolCallResult).correlate()}" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="Activity_0q8uboi" name="Send email" camunda:delegateExpression="${sendEmailDelegate}">
        <bpmn:incoming>Flow_1dlwpiw</bpmn:incoming>
        <bpmn:outgoing>Flow_0y3gf7n</bpmn:outgoing>
      </bpmn:serviceTask>
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_0pnuvic" name="Tool: getWeather" triggeredByEvent="true">
      <bpmn:documentation>Returns the current weather for a location.</bpmn:documentation>
      <bpmn:startEvent id="Event_1s1o62r" isInterrupting="false" camunda:asyncBefore="true">
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="location" value="fromAi(&#34;toolCall.location&#34;, &#34;Location to look up the weather for&#34;)" />
          </camunda:properties>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0w55kz2</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0q9bx40" messageRef="Msg_getWeather" />
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_1i3fa6w" name="LLM-Result">
        <bpmn:incoming>Flow_0bagva0</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0wrd2ky" camunda:expression="${execution.processEngineServices.runtimeService.createMessageCorrelation(&#39;LLM-Result&#39;).processInstanceId(execution.processInstanceId).setVariable(&#39;toolCallResult&#39;, toolCallResult).correlate()}" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="Activity_0nm3vx8" name="Get weather" camunda:delegateExpression="${getWeatherDelegate}">
        <bpmn:incoming>Flow_0w55kz2</bpmn:incoming>
        <bpmn:outgoing>Flow_0bagva0</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0w55kz2" sourceRef="Event_1s1o62r" targetRef="Activity_0nm3vx8" />
      <bpmn:sequenceFlow id="Flow_0bagva0" sourceRef="Activity_0nm3vx8" targetRef="Event_1i3fa6w" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_agentic-demo">
